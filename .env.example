# ==============================================================================
# Vasooli Tracker Environment Configuration (.env)
# ==============================================================================
# All variables below are OPTIONAL for local development. 
# The application automatically falls back to Yahoo Finance API and SQLite if omitted.

# ------------------------------------------------------------------------------
# 1. Market Data API Keys (Optional)
# ------------------------------------------------------------------------------
# Free key available at https://finnhub.io (used for additional US equity quote coverage)
FINNHUB_API_KEY=

# ------------------------------------------------------------------------------
# 2. Security & Auth Configuration (Optional)
# ------------------------------------------------------------------------------
SECRET_KEY=vasooli_tracker_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ------------------------------------------------------------------------------
# 3. Database Configuration (Optional - Defaults to SQLite ./vasooli.db)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vasooli_db

# Or configure individual Postgres fields:
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=vasooli_db
# POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. Frontend Environment Variables (Frontend root / Vite)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:5001/api/v1
