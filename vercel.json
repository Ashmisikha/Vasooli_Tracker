{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?path=:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index.py?path=:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?path=health"
    }
  ]
}
